# KAM — deployment secrets. Copy to `secrets.env` and fill in.
#
# `secrets.env` is in .gitignore and never enters a Docker image (.dockerignore).
# It is a place to keep the values together while setting the hosting up; the
# running service reads them as environment variables from Render / Cloud Run,
# not from this file.
#
# Fill every line marked REQUIRED before the first deploy.

# --- Hosting ------------------------------------------------------------
# Firebase / Google Cloud project that owns the Cloud Run service and the
# public URL https://hack-a-ton-hushkys.web.app
FIREBASE_PROJECT_ID=hack-a-ton-hushkys
GCP_REGION=europe-west1
# REQUIRED for a scripted deploy: a service-account JSON key with the roles
# "Cloud Run Admin", "Firebase Hosting Admin", "Service Account User" and
# "Artifact Registry Writer". Path to the file, not its contents.
GCP_SERVICE_ACCOUNT_KEY_FILE=

# Render is the alternative to Cloud Run; only one of the two is needed.
# API key from https://dashboard.render.com/u/settings#api-keys
RENDER_API_KEY=

# --- Database -----------------------------------------------------------
# REQUIRED. Neon, Render Postgres, Supabase — anything psycopg 3 speaks.
# Neon connection strings need ?sslmode=require on the end, and the driver
# prefix has to be psycopg (not the default psycopg2):
#   postgresql+psycopg://user:password@ep-xxx.eu-central-1.aws.neon.tech/kam?sslmode=require
DATABASE_URL=

# --- Access -------------------------------------------------------------
# REQUIRED. The shared password for the whole site (HTTP Basic). Leave the
# password empty only if the deployment is meant to be public.
KAM_AUTH_USER=kam
KAM_AUTH_PASSWORD=

# REQUIRED. Fernet key that encrypts API keys stored in the database. Without
# it a redeploy generates a new one and the stored keys stop decrypting.
# Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KAM_SECRET_KEY=

# --- Models -------------------------------------------------------------
# The cloud tier. Without a key the assistant still answers, from data only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# No LM Studio on a server: point the local tier at a dead port so the router
# goes straight to the cloud model instead of waiting for a connect timeout.
LOCAL_LLM_BASE_URL=http://127.0.0.1:9/v1

# --- Behaviour ----------------------------------------------------------
KAM_BACKGROUND=1
