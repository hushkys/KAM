# KAM — konfigurace. Zkopírujte jako .env a upravte. Nic zde není povinné.

# Databáze. Prázdné = lokální SQLite v data/kam.db.
# PostgreSQL: postgresql+psycopg://uzivatel:heslo@localhost:5432/kam
DATABASE_URL=

# Server
KAM_HOST=127.0.0.1
KAM_PORT=8000

# Lokální model (LM Studio, Ollama, llama.cpp — OpenAI-kompatibilní API)
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=google/gemma-4-e4b
LOCAL_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# Cloudový model (volitelné). Klíč lze zadat i v aplikaci: Nastavení → Modely AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Roky načítané z ČSÚ MOS
KAM_MOS_FIRST_YEAR=2005
KAM_MOS_LAST_YEAR=2025

# Úlohy na pozadí (zahřátí modelu, embeddingy, plánovaná aktualizace dat)
KAM_BACKGROUND=1
